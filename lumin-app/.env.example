# Lumin website. These are read when the site is BUILT (Railway: set them as Variables, then redeploy).
# Address of the backend, e.g. https://lumin-backend-production.up.railway.app (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Same Google client id as the backend's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Sign in with Apple. Website: the Services ID. iPhone app: its bundle id. Leave empty to hide the button.
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_NATIVE_CLIENT_ID=
# Twin discovery layer; turn on together with TWIN_ENABLED=true on the backend.
NEXT_PUBLIC_TWIN_ENABLED=false
# Scan: check recordings on the device and send only a small fingerprint (default on). false = upload recordings.
NEXT_PUBLIC_ON_DEVICE_SCAN=true
# Platform name shown in the app, page titles, install name and share messages. Empty = "Lumin".
# The logo is the file lumin-app/public/brand/logo.png - replace that file with your own (square PNG, 192x192 or larger).
NEXT_PUBLIC_APP_NAME=
# true (default) = the logo picture already contains the name, so it is shown alone. false = symbol-only logo: the name is written beside it.
NEXT_PUBLIC_LOGO_HAS_NAME=true
