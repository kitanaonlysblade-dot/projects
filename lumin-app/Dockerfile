# syntax=docker/dockerfile:1

# Three stages: install deps once (its own layer, so editing app code
# never busts it and triggers a full reinstall), build the standalone
# Next.js server, then copy only that build's own output into a minimal
# final image — no node_modules, no dev tooling, no source maps for
# packages that were never touched. See next.config.js's own comment on
# `output: 'standalone'`, which is what makes this last part possible.

FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json ./
# No package-lock.json is committed yet, so `npm ci` — which refuses to
# run without one — isn't an option here. `npm install` works either
# way; generating and committing a lockfile later (`npm install` once
# locally, commit the result) would make this reproducible/faster
# without needing to touch this file — npm ci and npm install behave
# identically here as long as one exists.
RUN npm install

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Next.js inlines every NEXT_PUBLIC_* value into the client JS at BUILD
# time, not read at runtime like a normal env var — so these have to
# arrive as Docker build args and get exported to ENV before `next
# build` runs, not just set on the deployed service afterward. On
# Railway specifically: declaring them as ARG here is what makes Railway
# pass the service's own configured variables through as build args
# automatically; without this, the deployed app would silently build
# with empty values (or whichever defaults lib/api.ts/GoogleSignInButton
# fall back to) baked in, pointed at nothing real, and no amount of
# changing the service's env vars afterward would fix it short of
# rebuilding.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Runs as a non-root user — standalone's own server.js has no need for
# root, and nothing in this stage writes to the filesystem at runtime.
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
# .next/standalone already contains a pruned copy of node_modules (just
# what this app's own import graph actually reaches) plus server.js —
# copying the full node_modules from the builder stage on top of it
# would be redundant, not more complete.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

# Informational only — Railway (like most container hosts) assigns the
# real port via $PORT at deploy time and routes to that, regardless of
# what's declared here. server.js (generated by the standalone build)
# already reads process.env.PORT itself, falling back to 3000 for a
# plain `docker run` with no $PORT set, e.g. one off a local build of
# this same image.
EXPOSE 3000

CMD ["node", "server.js"]
